# Copy this file to .env and fill in real values. Never commit .env itself.

# Get a free key from https://aistudio.google.com/
GEMINI_API_KEY=

# Optional — only needed as a transcription fallback. Get a free key from https://console.groq.com/
GROQ_API_KEY=

# Optional overrides — defaults are fine for Phase 1
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
